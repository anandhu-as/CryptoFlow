generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Watchlist {
  id           String   @id @default(cuid())
  userId       String
  coinId       String
  coinName     String
  coinImage    String
  symbol       String
  coinPrice    Float    @default(0)
  addedAt      DateTime @default(now())

  @@unique([userId, coinId])
}
