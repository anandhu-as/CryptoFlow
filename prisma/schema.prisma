generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String // Clerk user ID
  coinId    String // e.g. "bitcoin" from CoinGecko
  coinName  String
  coinImage String
  symbol    String
  addedAt   DateTime @default(now())

  @@unique([userId, coinId]) // prevent duplicate entries
}
